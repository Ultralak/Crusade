config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Crusade"
run/main_scene="uid://bptski33x28bx"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://Old_Crusade_sidescroller/icon.svg"

[autoload]

