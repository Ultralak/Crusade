;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Crusade"
run/main_scene="uid://cpe7igoj4lqdp"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

PlayerManager="*res://autoloads/player_manager.gd"
EnemyHealthManager="*res://autoloads/EnemyHealthManager.gd"
EnemyManager="*res://autoloads/EnemyManager.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[editor]

movie_writer/movie_file="C:/Users/david/OneDrive/Documents/Crusade/Crusade/GD/Videos/Day 13,14,15,16,17.avi"
movie_writer/fps=30

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_super-wakatime/plugin.cfg")

[global_group]

PLAYER_="all player characters"
ENEMY_=""
GROUND_=""

