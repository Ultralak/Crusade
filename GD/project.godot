[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1280
window/size/window_height_override=720
window/subwindows/embed_subwindows=false
window/stretch/mode="canvas_items"
mouse_cursor/custom_image="uid://caap00xbit37"
mouse_cursor/custom_image_hotspot=Vector2(16, 16)

[editor]

movie_writer/movie_file="C:/Users/3036264/Documents/GitHub/Crusade/GD/Videos/Devlog_4.avi"
movie_writer/fps=30

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_super-wakatime/plugin.cfg", "res://addons/kanban_tasks/plugin.cfg")

[global_group]

